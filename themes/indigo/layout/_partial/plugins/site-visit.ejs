<% if (theme.visit_counter) { %>
<p>
    <span><%- theme.visit_counter.today %><span id="wl_visit_today">-</span></span>
    <span><%- theme.visit_counter.total %><span id="wl_visit_total">-</span></span>
</p>
<script>
(function () {
    // 访问量接口地址：固定用「当前浏览器访问的地址」+/api（页面部署在哪个域名就上报到哪个域名，
    // 不再取构建时写死的站点 url）；浏览器拿不到 origin 时才回退到主题/站点配置
    var API = (window.location.origin || '<%- theme.visit_counter.api || config.url %>' || '').replace(/\/+$/, '');
    if (!API) { return; }
    function render(d) {
        if (!d) { return; }
        var t = document.getElementById('wl_visit_today');
        var s = document.getElementById('wl_visit_total');
        if (t && d.today != null) { t.textContent = d.today; }
        if (s && d.total != null) { s.textContent = d.total; }
    }
    // 上报一次访问：同一访客同一天在同一站点只计一次，刷新不会重复增加；接口会回传最新数值
    // 带上当前站点 origin，后台据此区分是哪个站点被访问
    fetch(API + '/api/visit', {
        method: 'POST',
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ site: window.location.origin })
    })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d && d.ok) { render(d); } })
        .catch(function () {
            // 上报失败时退化为只读查询
            fetch(API + '/api/visit/stats')
                .then(function (r) { return r.json(); })
                .then(render)
                .catch(function () {});
        });
})();
</script>
<% } %>