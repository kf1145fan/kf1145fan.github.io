<% if (theme.visit_counter) { %>
<script>
(function () {
    var API = ('<%- theme.visit_counter.api || config.url %>' || '').replace(/\/+$/, '');
    if (!API) { return; }
    // 每次访问上报一次（全站生效）：同一访客同一天只计一次，刷新不重复
    try {
        if (navigator.sendBeacon) {
            navigator.sendBeacon(API + '/api/visit');
            return;
        }
    } catch (e) {}
    fetch(API + '/api/visit', { method: 'POST', keepalive: true }).catch(function () {});
})();
</script>
<% } %>