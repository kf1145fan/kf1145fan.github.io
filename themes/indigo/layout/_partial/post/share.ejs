<div class="<%- scope %>-share" id="<%- scope %>Share">
    <ul class="reset share-icons">
      <li>
        <a class="qq share-sns" href="javascript:;" data-title="复制链接" onclick="copyArticleLink(this)">
          <i class="icon icon-link"></i>
        </a>
      </li>
    </ul>
 </div>

<script>
function copyArticleLink(btn) {
    var url = window.location.origin + window.location.pathname.replace(/index\.html$/, '');
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function() {
            var tip = btn.querySelector('.copy-tip');
            if (!tip) {
                tip = document.createElement('span');
                tip.className = 'copy-tip';
                tip.style.cssText = 'margin-left:6px;font-size:12px;color:#3F51B5;';
                btn.appendChild(tip);
            }
            tip.textContent = '已复制';
            setTimeout(function() { tip.textContent = ''; }, 2000);
        }).catch(function() { fallbackCopy(url, btn); });
    } else {
        fallbackCopy(url, btn);
    }
}
function fallbackCopy(url, btn) {
    var ta = document.createElement('textarea');
    ta.value = url;
    ta.style.cssText = 'position:fixed;left:-9999px;top:0';
    document.body.appendChild(ta);
    ta.select();
    try {
        document.execCommand('copy');
        btn.querySelector('.copy-tip') && (btn.querySelector('.copy-tip').textContent = '已复制');
    } catch(e) {}
    document.body.removeChild(ta);
}
</script>
