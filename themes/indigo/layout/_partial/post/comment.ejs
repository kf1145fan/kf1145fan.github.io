<% if (theme.waline && theme.waline.serverURL) { %>
<h3>订阅博客</h3>
<form id="blogSubscribeForm" autocomplete="off">
    <input type="email" id="blogSubscribeEmail" placeholder="请输入邮箱" required>
    <button type="submit">订阅</button>
</form>
<p id="blogSubscribeMsg"></p>
<script>
    (function () {
        var API = <%- JSON.stringify(String(theme.waline.serverURL || '').replace(/\/waline\/?$/, '')) %>;
        var form = document.getElementById('blogSubscribeForm');
        if (!form) return;
        var input = document.getElementById('blogSubscribeEmail');
        var msg = document.getElementById('blogSubscribeMsg');
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var email = (input.value || '').trim();
            if (!email) return;
            msg.textContent = '提交中…';
            fetch(API + '/api/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            }).then(function (r) { return r.json().catch(function () { return {}; }); })
                .then(function (data) {
                    if (data && data.ok) {
                        msg.textContent = data.message || '订阅成功';
                        input.value = '';
                    } else {
                        msg.textContent = (data && data.error) || '订阅失败，请稍后重试';
                    }
                })
                .catch(function () { msg.textContent = '网络异常，请稍后重试'; });
        });
    })();
</script>
<% } %>